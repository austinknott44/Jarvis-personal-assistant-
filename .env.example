# ---- Core ----
JARVIS_NAME=Jarvis
TIMEZONE=America/New_York
DATABASE_URL=postgresql+psycopg://jarvis:jarvis@localhost:5432/jarvis
ENCRYPTION_KEY=            # generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"

# ---- Brain / Voice (Gemini free tier — KEEP BILLING DISABLED on this project) ----
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-3-flash
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# ---- Notifications (ntfy) ----
NTFY_TOPIC=                 # e.g. jarvis-approvals-<random-string>; subscribe in the ntfy iPhone app
NTFY_SERVER=https://ntfy.sh

# ---- Email: Gmail (OAuth) ----
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# ---- Email: Outlook / .edu (Microsoft Graph) ----
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
# NOTE: your university may block third-party app access. Degrades to read-only/disabled.

# ---- Email: iCloud (IMAP, read-only) ----
ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=        # app-specific password from appleid.apple.com (stored encrypted via Preferences tab)

# ---- School: Brightspace at Purdue (NO student API — iCal feed only) ----
BRIGHTSPACE_ICAL_URL=

# ---- Investments (Robinhood has NO official equity API — manual holdings + Alpha Vantage) ----
ALPHAVANTAGE_API_KEY=
# Optional read-only auto-sync via SnapTrade (official OAuth, cannot trade):
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# DO NOT use robin_stocks / unofficial APIs.

# ---- Lifestyle (optional; degrade gracefully if blank) ----
MEALIE_BASE_URL=
MEALIE_API_TOKEN=
WGER_BASE_URL=
WGER_API_TOKEN=
RSS_FEEDS=

# ---- Optional voice upgrade ----
ELEVENLABS_API_KEY=
USE_ELEVENLABS=false

# ---- Morning brief ----
MORNING_BRIEF_TIME=07:00
